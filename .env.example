# Anthropic Claude API (Powers PathPilot Coach)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Supabase (Database, Auth, Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Resend (Email reminders: "timer ending soon" and "timer ended")
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=PathPilot <coach@yourdomain.com>
# How many minutes before the 24h timer ends to send the "ending soon" email
REMINDER_MINUTES_BEFORE=60

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your_secure_cron_secret_token_here

